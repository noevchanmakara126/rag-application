# ─────────────────────────────────────────────────────────────
# Copy to .env.development (dev) and .env.production (prod).
# Both files are gitignored. This file is the committed template.
# ─────────────────────────────────────────────────────────────

ENVIRONMENT=development

# ── Database ─────────────────────────────────────────────────
# Postgres with the pgvector extension. No SQLite fallback exists —
# pgvector has no equivalent, so this is required even for dev.
# From inside the dev stack : postgresql+asyncpg://rag:rag@db:5432/rag
# From the host             : postgresql+asyncpg://rag:rag@localhost:5433/rag
# Your own server           : postgresql+asyncpg://USER:PASSWORD@HOST:5432/rag
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5433/rag

# Used by the dev compose `db` service only. The container always listens on
# 5432 internally; POSTGRES_PORT is just the host mapping, defaulted off 5432
# so it does not collide with a Postgres already installed on the machine.
POSTGRES_PORT=5433
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag

# ── Generation (any OpenAI-compatible server) ─────────────────
# Ollama    : http://localhost:11434/v1
# vLLM      : http://localhost:8001/v1
# In Docker : http://host.docker.internal:11434/v1
LLM_BASE_URL=http://localhost:11434/v1
# The model the chat starts on, not a lock: the UI lists everything the
# server reports at GET /v1/models and switches per question. This is the
# fallback for any request that does not name one.
LLM_MODEL=qwen3:8b
# Most self-hosted servers ignore this; some refuse a request without it.
LLM_API_KEY=
LLM_TEMPERATURE=0.2

# ── Embeddings (any OpenAI-compatible server) ─────────────────
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=nomic-embed-text
# MUST match the vector(N) column the migration created.
#   nomic-embed-text 768 · mxbai-embed-large 1024 · all-minilm 384
# Changing this needs a new migration — or `make reset-db`.
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=32
# Asymmetric-retrieval task prefixes. nomic-embed-text, bge-* and e5-* all
# expect them, and omitting them collapses the score range so MIN_SCORE stops
# discriminating. Set both empty for a model that does not want them.
# Changing either invalidates stored vectors — re-ingest afterwards.
EMBEDDING_DOCUMENT_PREFIX="search_document: "
EMBEDDING_QUERY_PREFIX="search_query: "

# ── Retrieval ────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
# Cosine-similarity floor, calibrated for nomic-embed-text with the
# prefixes above (off-topic queries measured <=0.54, on-topic >=0.66).
# Re-measure with POST /api/v1/search if you change embedding model.
MIN_SCORE=0.55
MAX_UPLOAD_MB=20

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# ── Frontend ─────────────────────────────────────────────────
# Server-only. Never prefix with NEXT_PUBLIC_ — it must not
# reach the browser bundle.
# Bare metal : http://localhost:8000
# In Docker  : http://backend:8000
BACKEND_INTERNAL_URL=http://localhost:8000

NEXT_PUBLIC_APP_URL=http://localhost:3000
